#!/bin/sh
# Lifecycle for the isolated runtime. Never mutates the official Canon driver.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
LC_ALL=C
LANG=C
SOFTWARE=CanonLBP2900Standalone
export PATH LC_ALL LANG SOFTWARE
RUNTIME=/Library/Printers/Canon/LBP2900RT
SUPPORT='/Library/Application Support/CanonLBP2900Standalone'
PPD=/Library/Printers/PPDs/Contents/Resources/LocalLBP2900CAPT.ppd.gz
AGENT=/Library/LaunchAgents/jp.co.canon.LBP2900RT.BG.plist
LABEL=jp.co.canon.LBP2900RT.BackGrounder
STATE='/Library/Application Support/CanonLBP2900InstallState'
QUEUE=Canon_LBP2900
fail() { echo "LBP2900 driver: $*" >&2; exit 1; }
queue_exists() {
    # macOS lpstat may return success with empty output for a missing queue.
    lpstat -v 2>/dev/null | awk -v queue="$QUEUE" 'index($0, " " queue ": ") {found=1} END {exit !found}'
}
set_root() {
    root=${1:-/}
    case "$root" in /*) ;; *) fail 'Root must be absolute.';; esac
    [ "$root" != / ] || root=
}
owned_paths() {
    printf '%s\n' "$RUNTIME" "$SUPPORT" "$PPD" /usr/libexec/cups/backend/lb29u2 "$AGENT"
}
check() {
    [ -f "$root$SUPPORT/installed.sha256" ] || fail 'Installed manifest is missing.'
    for path in "$RUNTIME" "$SUPPORT"; do
        [ ! -L "$root$path" ] || fail "Private directory is a symlink: $path"
    done
    (cd "${root:-/}" && shasum -a 256 -c "$root$SUPPORT/installed.sha256")
    for app in 'StatusMonitor/StatusMonitor.app' 'BackGrounder/Canon 2900 BackGrounder.app'; do
        codesign --verify --deep --strict --all-architectures "$root$RUNTIME/$app"
    done
}
check_owned_paths() {
    scratch=$(mktemp -d /private/tmp/lbp2900-owned.XXXXXX)
    trap 'rm -R "$scratch"' EXIT HUP INT TERM
    cp "$root$SUPPORT/installed-paths.txt" "$scratch/expected"
    [ ! -e "$root$SUPPORT/queue-uri" ] || printf '%s\n' "${SUPPORT#/}/queue-uri" >> "$scratch/expected"
    sort -o "$scratch/expected" "$scratch/expected"
    (cd "${root:-/}" && find "${RUNTIME#/}" "${SUPPORT#/}" "${PPD#/}" \
        usr/libexec/cups/backend/lb29u2 "${AGENT#/}" \( -type f -o -type l \) -print) | sort > "$scratch/actual"
    cmp -s "$scratch/expected" "$scratch/actual" || fail 'Unrecognized files exist in the private runtime; nothing removed.'
    rm -R "$scratch"
    trap - EXIT HUP INT TERM
}
root_required() { [ "$(id -u)" -eq 0 ] || fail 'Run this command with sudo.'; }
private_pids() {
    # Do not select apps such as Preview merely because they load our PDE libraries.
    {
        ps -axo pid=,command= | awk -v base="$root$RUNTIME/" '
            {pid=$1; $1=""; sub(/^ +/, ""); if (index($0,base)==1) print pid}'
        # Older releases use other monitor names; all reside directly in Bidi.
        for executable in "$root$RUNTIME/Bidi/"*; do
            if [ -f "$executable" ] && [ -x "$executable" ]; then
                lsof -nP -a -d txt -t "$executable" 2>/dev/null || :
            fi
        done
    } | sort -nu
}
stop_private() {
    for uid in $(ps -axo uid= | sort -nu); do
        if launchctl print "gui/$uid/$LABEL" >/dev/null 2>&1; then
            launchctl bootout "gui/$uid/$LABEL"
        fi
    done
    pids=$(private_pids)
    for pid in $pids; do kill -TERM "$pid" 2>/dev/null || :; done
    attempts=0
    while [ -n "$(private_pids)" ] && [ "$attempts" -lt 15 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done
    # A retired idle USB monitor may ignore TERM. Recheck ownership before KILL.
    for pid in $(private_pids); do
        kill -KILL "$pid" 2>/dev/null || :
    done
    attempts=0
    while [ -n "$(private_pids)" ] && [ "$attempts" -lt 3 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done
    [ -z "$(private_pids)" ] || fail 'Private processes could not be stopped.'
}
has_installation() {
    [ -e "$root$RUNTIME" ] || [ -L "$root$RUNTIME" ] ||
        [ -e "$root$SUPPORT" ] || [ -L "$root$SUPPORT" ] ||
        [ -e "$root$PPD" ] || [ -L "$root$PPD" ] ||
        [ -e "$root/usr/libexec/cups/backend/lb29u2" ] ||
        [ -L "$root/usr/libexec/cups/backend/lb29u2" ] ||
        [ -e "$root$AGENT" ] || [ -L "$root$AGENT" ]
}
validate_old_paths() {
    while IFS= read -r path; do
        case "$path" in /*|*'/../'*|*'/./'*|../*|*/..) fail 'Invalid owned path.';; esac
        case "/$path" in "$RUNTIME/"*|"$SUPPORT/"*|"$PPD"|"$AGENT"|/usr/libexec/cups/backend/lb29u2) ;;
            *) fail 'Unexpected owned path.';; esac
    done < "$root$SUPPORT/installed-paths.txt"
}
resume_installation() {
    [ -d "$root$STATE" ] && [ ! -L "$root$STATE" ] || fail 'Invalid install state.'
    if [ -z "$root" ]; then
        while IFS= read -r uid; do
            if launchctl print "gui/$uid" >/dev/null 2>&1 && ! launchctl print "gui/$uid/$LABEL" >/dev/null 2>&1; then
                launchctl bootstrap "gui/$uid" "$AGENT"
            fi
        done < "$STATE/agents"
        while read -r queue state; do
            [ "$state" = Stopped ] || cupsenable "$queue"
        done < "$STATE/queues"
    fi
    rm -R "$root$STATE"
}
private_queues() {
    listing=$(lpstat -v) || fail 'Cannot list printer queues.'
    printf '%s\n' "$listing" | awk '$NF ~ /^lb29u2:\/\// {queue=$(NF-1); sub(/:$/, "", queue); print queue}'
}
queue_state() {
    # IPP enums are stable across languages and reflect current scheduler state.
    attributes=$(ipptool -tv "ipp://localhost/printers/$1" /usr/share/cups/ipptool/get-printer-attributes.test) || fail 'Cannot read queue state.'
    state=$(printf '%s\n' "$attributes" | awk '$1=="printer-state" && $2=="(enum)" {print $4}')
    case "$state" in idle|processing) echo Idle;; stopped) echo Stopped;; *) fail 'Unknown queue state.';; esac
}
prepare_installation() {
    # Retry after a failed transaction only when installed files still validate.
    if [ -e "$root$STATE" ] || [ -L "$root$STATE" ]; then
        complete_installation recover
    fi
    if ! has_installation; then
        if [ -z "$root" ] && lsof -nP -iTCP:59290 -iTCP:59390 -sTCP:LISTEN >/dev/null 2>&1; then
            fail 'Ports 59290/59390 are already in use.'
        fi
        return
    fi
    check
    check_owned_paths
    validate_old_paths
    umask 077
    mkdir "$root$STATE"
    cp "$root$SUPPORT/installed-paths.txt" "$root$STATE/old-paths"
    : > "$root$STATE/queues"
    : > "$root$STATE/agents"
    if [ -z "$root" ]; then
        # Restore whatever has been paused if any preparation step fails.
        trap 'resume_installation' EXIT
        queues=$(private_queues)
        for queue in $queues; do
            state=$(queue_state "$queue")
            printf '%s %s\n' "$queue" "$state" >> "$STATE/queues"
        done
        while read -r queue state; do
            if [ -n "$(lpstat -o "$queue")" ]; then
                fail 'Finish or cancel Canon jobs before reinstalling.'
            fi
        done < "$STATE/queues"
        for uid in $(ps -axo uid= | sort -nu); do
            if launchctl print "gui/$uid/$LABEL" >/dev/null 2>&1; then
                printf '%s\n' "$uid" >> "$STATE/agents"
            fi
        done
        while read -r queue state; do
            cupsdisable "$queue"
            [ -z "$(lpstat -o "$queue")" ] || fail 'A Canon job arrived; retry after it finishes.'
        done < "$STATE/queues"
        stop_private
        trap - EXIT
    fi
}
complete_installation() {
    check
    if [ -e "$root$STATE" ] || [ -L "$root$STATE" ]; then
        [ -d "$root$STATE" ] && [ ! -L "$root$STATE" ] || fail 'Invalid install state.'
        while IFS= read -r path; do
            if ! grep -Fxq "$path" "$root$SUPPORT/installed-paths.txt"; then
                rm -f "$root/$path"
            fi
        done < "$root$STATE/old-paths"
        had_queues=$(cat "$root$STATE/queues")
        resume_installation
        if [ "${1:-}" != recover ] && [ -z "$root" ] && [ -z "$had_queues" ]; then
            exec "$0" configure-connected
        fi
        echo 'LBP2900 reinstalled; existing queues and printer options preserved.'
    elif [ -z "$root" ]; then
        exec "$0" configure-connected
    fi
}
official_monitor_pids() {
    # A removed CUPS queue can leave its Canon monitor holding this USB device.
    for pid in $(ps -axo pid=,command= | awk -v target="--printer-uri=$1" '
        {for (i=2; i<=NF; i++) if ($i==target) {print $1; break}}'); do
        if lsof -nP -a -p "$pid" -d txt -Fn 2>/dev/null | awk -v base="n$root/Library/Printers/Canon/" '
            index($0, base "CUPSCAPT2/Bidi/")==1 || index($0, base "CUPSCAPT/Bidi/")==1 {found=1}
            END {exit !found}'; then
            printf '%s\n' "$pid"
        fi
    done
}
case "${1:-}" in
preflight)
    [ "$#" -le 2 ] || fail 'Usage: preflight [absolute extraction root]'
    set_root "${2:-/}"
    if has_installation; then
        check
        check_owned_paths
        validate_old_paths
    elif [ -z "$root" ] && lsof -nP -iTCP:59290 -iTCP:59390 -sTCP:LISTEN >/dev/null 2>&1; then
        fail 'Ports 59290/59390 are already in use.'
    fi
    ;;
prepare-install|complete-install)
    [ "$#" -le 2 ] || fail 'Unexpected install arguments.'
    set_root "${2:-/}"
    [ -n "$root" ] || root_required
    if [ "$1" = prepare-install ]; then prepare_installation; else complete_installation; fi
    ;;
check)
    [ "$#" -le 2 ] || fail 'Usage: check [absolute extraction root]'
    set_root "${2:-/}"
    check
    ;;
configure-connected)
    root_required
    set_root
    [ "$#" -eq 1 ] || fail 'Usage: configure-connected'
    check
    # A fresh install may create one queue, but must never take over an existing one.
    if queue_exists && [ ! -f "$SUPPORT/queue-uri" ]; then
        echo 'An existing Canon_LBP2900 queue needs manual review; no queue changed.'
        exit 0
    fi
    devices=$(lpinfo -v | awk '$1=="direct" && $2 ~ /^usb:\/\/Canon\/LBP2900\?serial=[A-Za-z0-9%._~-]+$/ {print $2}' | sort -u)
    count=$(printf '%s\n' "$devices" | awk 'NF {n++} END {print n+0}')
    if [ "$count" -ne 1 ]; then
        echo 'Connect one powered-on LBP2900, then run this helper with configure-connected.'
        exit 0
    fi
    exec "$0" configure "$devices"
    ;;
configure)
    root_required
    set_root
    [ "$#" -eq 2 ] || fail 'Usage: configure usb://Canon/LBP2900?serial=...'
    case "$2" in 'usb://Canon/LBP2900?serial='?*) ;; *) fail 'Expected the exact LBP2900 USB URI from lpinfo -v.';; esac
    printf '%s' "$2" | /usr/bin/grep -Eq '^usb://Canon/LBP2900\?serial=[A-Za-z0-9%._~-]+$' || fail 'Unexpected USB URI characters.'
    check
    URI="lb29u2://localhost:59290/usbSP/${2#usb://}"
    if lpstat -v 2>/dev/null | /usr/bin/grep -F "cnbma2://localhost:59687/usbSP/${2#usb://}" >/dev/null; then
        fail 'This printer still has an official-runtime CAPT queue. Finish all jobs in Canon Utility and remove that queue before switching runtimes.'
    fi
    [ -z "$(official_monitor_pids "$2")" ] || fail 'The old Canon USB monitor is still running for this printer. After removing its old queue and finishing all Canon jobs, sign out and back in, then retry. No queue was changed.'
    if queue_exists; then
        [ -f "$SUPPORT/queue-uri" ] || fail 'Existing queue is not owned by this helper.'
        [ "$(cat "$SUPPORT/queue-uri")" = "$URI" ] || fail 'Existing queue belongs to another printer.'
        [ "$(lpstat -v "$QUEUE" | awk '{print $NF}')" = "$URI" ] || fail 'Queue URI was changed.'
        [ -z "$(lpstat -o "$QUEUE")" ] || fail 'Finish or cancel pending jobs first.'
    fi
    lpadmin -p "$QUEUE" -v "$URI" -P "$PPD" -D 'Canon LBP2900' -E \
        -o printer-is-shared=false -o printer-error-policy=stop-printer
    printf '%s\n' "$URI" > "$SUPPORT/queue-uri"
    chmod 600 "$SUPPORT/queue-uri"
    console_uid=$(stat -f %u /dev/console)
    if [ "$console_uid" -ge 500 ]; then
        launchctl enable "gui/$console_uid/$LABEL"
        if ! launchctl print "gui/$console_uid/$LABEL" >/dev/null 2>&1; then
            launchctl bootstrap "gui/$console_uid" "$AGENT"
        fi
    else
        echo 'Sign into the desktop to start the LBP2900 status service.'
    fi
    echo "Created $QUEUE. Open Printer Utility in macOS printer settings."
    ;;
remove)
    [ "$#" -le 2 ] || fail 'Usage: remove [absolute extraction root]'
    set_root "${2:-/}"
    [ -n "$root" ] || root_required
    check
    check_owned_paths
    if [ -z "$root" ] && lpstat -v 2>/dev/null | /usr/bin/grep -q 'lb29u2://'; then
        fail 'Finish all jobs in Canon Utility, then remove queues using this driver before removing the runtime.'
    fi
    if [ -z "$root" ]; then
        stop_private
    fi
    /bin/rm -R "$root$RUNTIME"
    /bin/rm "$root$PPD" "$root/usr/libexec/cups/backend/lb29u2" "$root$AGENT"
    /bin/rm -R "$root$SUPPORT"
    [ -n "$root" ] || pkgutil --forget local.canon-lbp2900.capt10.standalone
    echo 'LBP2900 runtime removed. Official Canon files and queues were not changed.'
    ;;
*) fail 'Usage: lbp2900-standalone preflight|prepare-install|complete-install|check|remove [root] | configure-connected | configure USB_URI';;
esac
